# ==============================================================================
# OTHERVIEW V3 ENVIRONMENT VARIABLES
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini Multimodal AI
# Get your API key from Google AI Studio: https://aistudio.google.com/
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 2. Appwrite Cloud Configuration
# Create a project at https://cloud.appwrite.io/
# ------------------------------------------------------------------------------
# Public API Endpoint (defaults to https://cloud.appwrite.io/v1 if unset)
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1

# Public Project ID (from Appwrite Console -> Project Settings)
NEXT_PUBLIC_APPWRITE_PROJECT_ID=

# Server-Only Appwrite API Key (Never prefix with NEXT_PUBLIC_)
# Create in Appwrite Console -> Project Settings -> API Keys
# Required scopes: databases.read, databases.write, collections.read, collections.write,
#                  tables.read, tables.write, files.read, files.write, users.read, users.write
APPWRITE_API_KEY=

# Optional: Custom Database and Storage IDs (defaults to otherview_db and inspection_images)
APPWRITE_DATABASE_ID=otherview_db
APPWRITE_STORAGE_BUCKET_ID=inspection_images
